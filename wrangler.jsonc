{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glass-tasks",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // フロントエンド（Vite のビルド結果）を Workers Static Assets で配信
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glass-tasks-db",
      // `wrangler d1 create glass-tasks-db` で表示される ID に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "ai": { "binding": "AI" },

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "GOOGLE_CLIENT_ID": "",
    "APP_ORIGIN": ""
  },
  // GOOGLE_CLIENT_SECRET / SESSION_SECRET は `wrangler secret put` で登録する

  "env": {
    // E2E テスト専用環境：開発用ログインを許可し、AI はモック応答
    "e2e": {
      "name": "glass-tasks-e2e",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glass-tasks-e2e",
          "database_id": "e2e-local",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "AI_MODEL": "mock",
        "GOOGLE_CLIENT_ID": "e2e-client-id.apps.googleusercontent.com",
        "GOOGLE_CLIENT_SECRET": "e2e-secret",
        "SESSION_SECRET": "e2e-session-secret",
        "APP_ORIGIN": "http://localhost:8787",
        "ALLOW_DEV_LOGIN": "true"
      }
    }
  }
}
