{
  "name": "glass-tasks",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k \"wrangler dev --port 8787\" \"vite\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply glass-tasks-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply glass-tasks-db --remote",
    "deploy": "vite build && wrangler d1 migrations apply glass-tasks-db --remote && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.151.3"
  },
  "private": true,
  "type": "module"
}
